#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h> // 蓝牙连接管理，最多5个连接
#include <dt-bindings/zmk/outputs.h> // 选择输出途径 蓝牙|USB
#include <dt-bindings/zmk/mouse.h> // 模拟鼠标操作
#include <dt-bindings/zmk/backlight.h> // 背光操作
#include <dt-bindings/zmk/ext_power.h> // 电源相关操作
#include <dt-bindings/zmk/trackpad_mode.h> // 触控板：鼠标 / 滚动 / 方向键


/**
 * ######################
 * #      说  明
 *######################
 *
 * ## 一、共 3 层：
 *      1. 字母层：字母
 *      2. 符号层：数字、符号
 *      3. 功能层：蓝牙设备切换(1–4)、重启(Q)、触控板电源、BootLoader、背光、输出切换
 *
 * ## 二、层级切换说明：
 *      1. 字母层：
 *
 *      2. 符号层：
 *          alt 点击：临时进入符号层，2 秒内点击任意符号，上屏对应符号并立即退出符号层，<四个键盘灯长亮>
 *          alt 长按：进入符号层，<四个键盘灯长亮>
 *
 *      3. 功能层：
 *          $ 键点击：输入 $
 *          $ 键长按：进入功能层，<四个键盘灯闪烁>
 *
 * ## 三、触控板模式（Blackberry 键）：
 *      单击：进入/退出滚动模式（触控板 LED 亮）
 *      双击：进入/退出方向键模式（划动发 ↑↓←→，触控板 LED 亮）
 *      Caps Lock 不再控制滚动
 *
 **/


#define SYM 1
#define UTIL 2

&sl {
    release-after-ms = <2000>;  // 粘滞层： 2 秒后如果没有按下其它键，将复原。默认值为 1000
};


/ {
    behaviors {
        // 动作: 短按 | 长按
        // 长按: 切换层
        // 短按: 普通按键
        htl: hold_toggle_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&tog &kp>;
        };
        // 动作: 单击 | 双击
        // 单击: 粘滞层
        // 双击: 切换层
        tdl: tap_dance_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl SYM>, <&tog SYM>;
        };
        // Blackberry：单击滚动模式，双击方向键模式（再按同手数退出）
        tdbb: tap_dance_trackpad {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&tp_mode TP_TOG_SCROLL>, <&tp_mode TP_TOG_ARROW>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         *    KEYBOARD LAYOUT
         *
                              ---------------------                                                                -------------------------
                             |    Shoulder Key1    |                                                              |      Shoulder Key2      |
                 ---------------------------------------------------------------------------------------------------------------------------------------------------
                |        Call key        |   Blackberry Key    |              Trackpad            |             Back Key           |          Endcall Key           |
                -----------------------------------------------------------------------------------------------------------------------------------------------------
                |     Q      |     W     |     E    |     R    |         T       |       Y        |        U       |       I       |        O        |      P       |
                -----------------------------------------------------------------------------------------------------------------------------------------------------
                |     A      |     S     |     D    |     F    |         G       |       H        |        J       |       K       |        L        |      ←       |
                -----------------------------------------------------------------------------------------------------------------------------------------------------
                 \    alt    |     Z     |     X    |     C    |         V       |       B        |        N       |        M       |        $        |    Enter    /
                   -----------------------------------------------------------------------------------------------------------------------------------------------
                              \      aA        |       0        |                    SPACE                  |          SYM          |         aA    /
                                -------------------------------------------------------------------------------------------------------------------
        */

        /*==================
         *  1. 字母层 DEFAULT
         *==================*/
        default_layer {
                bindings = <
            //                  TOP LEFT BUTTON                                                                                          TOP RIGHT BUTTON
                                &mkp LCLK                                                                                                &mkp RCLK

            //  PHONE                       BLACKBERRY                                TOUCH_PAD                          BACK                             HUNG_UP
                &kp CLCK                    &tdbb                                     &mkp LCLK                          &kp ESC                          &kp TAB

            //  Q               W           E           R          T                  Y                 U                I               O                P
                &kp Q           &kp W       &kp E       &kp R     &kp T               &kp Y             &kp U            &kp I           &kp O            &kp P

            //  A               S           D           F          G                  H                 J                K               L                BACKSPACE
                &kp A           &kp S       &kp D       &kp F     &kp G               &kp H             &kp J            &kp K           &kp L            &kp BSPC

            //  Alt             Z           X           C          V                  B                 N                M               $                ENTER
                &tdl            &kp Z       &kp X       &kp C     &kp V               &kp B             &kp N            &kp M           &htl UTIL DLLR   &kp ENTER

            //                  LSHIFT            0                                   SPACE                     SYM                      RSHIFT
                                &kp LSHFT         &mt LCTRL N0                        &kp SPACE                 &kp N2                   &kp RSHFT
            >;
        };


        /*==================
        * 2. 符号层 SYMBOL
        *==================*/
        sym_layer {
            bindings = <
            //                  TOP LEFT BUTTON                                                                                         TOP RIGHT BUTTON
                                &msc SCRL_UP                                                                                            &msc SCRL_DOWN

            //  PHONE                       BLACKBERRY                                TOUCH_PAD                          BACK                             HUNG_UP
                &kp CLCK                    &tdbb                                     &mkp LCLK                          &kp ESC                          &kp TAB

            //  Q               W           E           R          T                  Y                 U                I               O                P
                &kp HASH        &kp N1      &kp N2      &kp N3    &mt LBKT LPAR       &mt RBKT RPAR     &kp UNDER        &kp MINUS       &kp PLUS         &kp AT

            //  A               S           D           F          G                  H                 J                K               L                BACKSPACE
                &kp STAR        &kp N4      &kp N5      &kp N6    &kp SLASH           &kp COLON         &kp SEMI         &kp APOS        &kp DQT          &kp BSPC

            //  Alt             Z           X           C          V                  B                 N                M               $                ENTER
                &tog SYM        &kp N7      &kp N8      &kp N9    &kp QMARK           &kp EXCL          &kp COMMA        &kp DOT         &kp C_MUTE       &kp ENTER

            //                  LSHIFT            0                                   SPACE                     SYM                      RSHIFT
                                &kp LSHFT         &mt LCTRL N0                        &kp SPACE                 &kp N2                   &kp RSHFT
            >;
        };


        /*==================
        *  3. 功能层 UTILITY
        *     1/2/3/4 → 蓝牙设备 0–3
        *     Q → 重启
        ==================*/
        util_layer {
            bindings = <
            //                  TOP LEFT BUTTON                                                                                          TOP RIGHT BUTTON
                                &mkp LCLK                                                                                                &mkp RCLK

            //  PHONE                       BLACKBERRY                                TOUCH_PAD                          BACK                             HUNG_UP
                &kp CLCK                    &tdbb                                     &mkp LCLK                          &kp ESC                          &kp TAB

            //  Q               W           E           R          T                  Y                 U                I               O                P
                &sys_reset      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &ext_power EP_TOG &none           &out OUT_TOG     &none           &none            &none

            //  A               S           D           F          G                  H                 J                K               L                BACKSPACE
                &none           &bt BT_SEL 3 &none      &none      &none              &none             &none            &none           &none            &bt BT_CLR

            //  Alt             Z           X           C          V                  B                 N                M               $                ENTER
                &none           &bootloader &none       &none      &bl BL_DEC         &bl BL_TOG        &bl BL_INC       &none           &tog UTIL        &kp ENTER

            //                  LSHIFT            0                                   SPACE                     SYM                      RSHIFT
                                &kp LSHFT         &mt LCTRL N0                        &kp SPACE                 &kp N2                   &kp RSHFT
            >;
        };
    };
};
